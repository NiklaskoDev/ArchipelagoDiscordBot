# Copy to .env and fill in. Names and placeholders only - never real values in this file.
# Keep in sync with every variable the code reads.

# Required. The bot token of your Discord application.
DISCORD_TOKEN=

# Required. The manager's address without a path. In the example compose file the service name is used.
MANAGER_URL=http://archipelago-manager:8080

# Required. API token (starts with apm_) of the bot's account on the manager: a plain user, access "Read".
MANAGER_API_TOKEN=apm_

# Required. Encrypts the manager tokens people link with /link. One or more Fernet keys separated by commas, the first
# one encrypts, all decrypt. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Lose it and everyone has to link again.
BOT_ENCRYPTION_KEY=

# Optional.
# DATA_DIR=/data
# LOG_LEVEL=INFO
# DISCORD_DEV_GUILD_ID=       # development only: register commands in this server only

# Container only.
# PUID=99
# PGID=100
# UMASK=022
# TZ=Europe/Berlin
